<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DotNodeViewer.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="700"
             x:Class="DotNodeViewer.App.Views.PropertiesPanelView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource ShellSurfaceBaseBrush}">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Padding="16,14">
    <StackPanel Spacing="16">

      <!-- ========================================================= -->
      <!-- 0. ON-DEMAND TENSOR WEIGHT INSPECTOR (WHEN OPEN)          -->
      <!-- ========================================================= -->
      <Border IsVisible="{Binding IsTensorInspectorOpen}"
              Background="{DynamicResource ShellSurfaceElevatedBrush}"
              BorderBrush="{DynamicResource ShellAccentPrimaryBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusMedium}"
              Padding="14,12"
              AutomationProperties.Name="Tensor Weight Inspector"
              AutomationProperties.AutomationId="TensorWeightInspectorPanel">
        <StackPanel Spacing="10" DataContext="{Binding TensorInspector}">
          <!-- Header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Background="{DynamicResource ShellAccentPrimaryBrush}"
                        CornerRadius="{DynamicResource RadiusPill}"
                        Padding="6,1">
                  <TextBlock Text="WEIGHT INSPECTOR"
                             FontSize="9"
                             FontWeight="Bold"
                             Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="{Binding TensorName}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource ShellTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Text="{Binding DataTypeText, StringFormat='Data Type: {0}'}"
                         FontSize="10.5"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
              <TextBlock Text="{Binding ShapeText, StringFormat='Shape: {0}'}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="10.5"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="toolbar-btn"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTensorInspectorCommand}"
                    ToolTip.Tip="Close Inspector"
                    AutomationProperties.Name="Close Tensor Inspector"
                    AutomationProperties.AutomationId="CloseTensorInspectorButton"
                    VerticalAlignment="Top"
                    Padding="6,4">
              <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
            </Button>
          </Grid>

          <!-- Slice Metadata -->
          <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                  BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Padding="10,6">
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Stream Offset:" FontSize="9.5" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                <TextBlock Text="{Binding StreamOffsetHex}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Payload Size:" FontSize="9.5" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                <TextBlock Text="{Binding ByteLengthFormatted}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Statistics (if available) -->
          <Border IsVisible="{Binding HasStatistics}"
                  Background="{DynamicResource ShellSurfaceBaseBrush}"
                  BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Padding="10,8">
            <StackPanel Spacing="6">
              <TextBlock Text="Sample Statistics (Preview Window)"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Min" FontSize="9" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                  <TextBlock Text="{Binding MinValue, StringFormat='{}{0:G4}'}"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Max" FontSize="9" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                  <TextBlock Text="{Binding MaxValue, StringFormat='{}{0:G4}'}"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Mean" FontSize="9" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                  <TextBlock Text="{Binding MeanValue, StringFormat='{}{0:G4}'}"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Zero %" FontSize="9" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                  <TextBlock Text="{Binding ZeroPercentage, StringFormat='{}{0:F1}%'}"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="11"
                             Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="NaN / Inf" FontSize="9" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                  <TextBlock Text="{Binding HasNaN, Converter={x:Static ObjectConverters.IsNull}}"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="11"
                             Foreground="{DynamicResource ShellSuccessBrush}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Dequantization Note -->
          <Border IsVisible="{Binding HasDequantization}"
                  Background="{DynamicResource ShellSuccessSubtleBrush}"
                  BorderBrush="{DynamicResource ShellSuccessBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Padding="8,4">
            <TextBlock Text="{Binding QuantizationDescription, StringFormat='Dequantized Preview ({0})'}"
                       FontSize="10"
                       Foreground="{DynamicResource ShellSuccessBrush}" />
          </Border>

          <!-- External Reference Message -->
          <Border IsVisible="{Binding IsExternal}"
                  Background="{DynamicResource ShellSurfaceBaseBrush}"
                  BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Padding="8,6">
            <StackPanel Spacing="3">
              <TextBlock Text="External Shard Reference:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              <TextBlock Text="{Binding ExternalPath}" FontFamily="{DynamicResource CodeFontFamily}" FontSize="10" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
              <TextBlock Text="{Binding ExternalOffset, StringFormat='Offset: {0:N0} bytes'}" FontSize="9.5" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <!-- Values Preview Table -->
          <StackPanel Spacing="4" IsVisible="{Binding PreviewValues.Count}">
            <TextBlock Text="Preview Values (First 64 Elements)"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                    BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    MaxHeight="180">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PreviewValues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TensorValuePreviewItem">
                      <Border BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="8,3">
                        <Grid ColumnDefinitions="40,*,*">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Index, StringFormat='[{0}]'}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="9.5"
                                     Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding RawValue}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding DequantizedValue, StringFormat='~ {0}'}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellSuccessBrush}"
                                     IsVisible="{Binding HasDequantized}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <!-- Error Message -->
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{DynamicResource ShellDangerBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- ========================================================= -->
      <!-- 1. GRAPH OVERVIEW (WHEN NO NODE IS SELECTED)             -->
      <!-- ========================================================= -->
      <StackPanel IsVisible="{Binding !HasSelectedNode}" Spacing="16">

        <!-- Header Strip -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="14,12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource ShellAccentSubtleBrush}"
                      BorderBrush="{DynamicResource ShellAccentPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource RadiusPill}"
                      Padding="8,2"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding FormatDisplayName}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
              </Border>
              <TextBlock Text="Model Properties"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding ProducerName, StringFormat='Producer: {0}'}"
                       FontSize="11"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />

            <TextBlock Text="{Binding SelectedSubgraph.Name, StringFormat='Subgraph: {0}'}"
                       FontSize="11"
                       FontFamily="{DynamicResource CodeFontFamily}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
          </StackPanel>
        </Border>

        <!-- High-level Metric Pills Grid -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,10">
          <Grid ColumnDefinitions="*,*,*,*">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
              <TextBlock Text="{Binding TotalNodeCount}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Nodes"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="{Binding TotalEdgeCount}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Edges"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding TotalTensorCount}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Tensors"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
              <TextBlock Text="{Binding QuantizedTensorCount}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ShellSuccessBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Quantized"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Subgraph Inputs Section -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Model Inputs"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="5,1">
              <TextBlock Text="{Binding Inputs.Count}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Inputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TensorSummaryItem">
                <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10,6"
                        Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="Medium"
                                 FontSize="11"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}" />

                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding DataTypeText}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                        <TextBlock Text="{Binding ShapeText}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                      </StackPanel>

                      <TextBlock Text="{Binding Details}"
                                 FontSize="9"
                                 Foreground="{DynamicResource ShellSuccessBrush}"
                                 IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="sample-btn"
                              Padding="6,2"
                              IsVisible="{Binding CanInspectWeights}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectTensorCommand}"
                              CommandParameter="{Binding Tensor}"
                              AutomationProperties.Name="Inspect Tensor Weights"
                              ToolTip.Tip="Inspect raw weights, statistics, and values">
                        <TextBlock Text="Weights 🔍" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                      </Button>

                      <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                              BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                              BorderThickness="1"
                              CornerRadius="{DynamicResource RadiusPill}"
                              Padding="6,2">
                        <TextBlock Text="{Binding QuantizationBadge}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Subgraph Outputs Section -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Model Outputs"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="5,1">
              <TextBlock Text="{Binding Outputs.Count}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Outputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TensorSummaryItem">
                <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10,6"
                        Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="Medium"
                                 FontSize="11"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}" />

                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding DataTypeText}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                        <TextBlock Text="{Binding ShapeText}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                      </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ShellSurfaceBaseBrush}"
                            BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusPill}"
                            Padding="6,2"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding QuantizationBadge}"
                                 FontFamily="{DynamicResource CodeFontFamily}"
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Operator Category Distribution -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Operator Categories"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="5,1">
              <TextBlock Text="{Binding OperatorCategories.Count}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="10"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding OperatorCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OperatorCategorySummaryItem">
                <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10,6"
                        Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="11"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ShellSurfaceBaseBrush}"
                            CornerRadius="{DynamicResource RadiusPill}"
                            Padding="6,1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Count}"
                                 FontFamily="{DynamicResource CodeFontFamily}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>

      <!-- ========================================================= -->
      <!-- 2. NODE INSPECTOR (WHEN A NODE IS SELECTED)              -->
      <!-- ========================================================= -->
      <StackPanel IsVisible="{Binding HasSelectedNode}" Spacing="16">

        <!-- Selected Node Header Card -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="14,12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{DynamicResource ShellAccentSubtleBrush}"
                        BorderBrush="{DynamicResource ShellAccentPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusPill}"
                        Padding="8,2"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedNodeCategoryName}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                </Border>

                <TextBlock Text="{Binding SelectedNodeVersion, StringFormat='v{0}'}"
                           FontSize="10"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding SelectedNodeVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <TextBlock Text="{Binding SelectedNodeTitle}"
                         FontSize="14"
                         FontWeight="Bold"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding SelectedNodeSubtitle}"
                         FontSize="11"
                         Foreground="{DynamicResource ShellAccentPrimaryBrush}"
                         IsVisible="{Binding SelectedNodeSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <TextBlock Text="{Binding SelectedNodeDocSummary}"
                         FontSize="11"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SelectedNodeDocSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- Unwrap Delegate Subgraph Action -->
              <Button IsVisible="{Binding CanExpandSelectedDelegate}"
                      Command="{Binding ExpandSelectedDelegateCommand}"
                      Background="{DynamicResource ShellAccentSubtleBrush}"
                      BorderBrush="{DynamicResource ShellAccentPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource RadiusSmall}"
                      Margin="0,6,0,0"
                      Padding="10,6"
                      HorizontalAlignment="Left"
                      Cursor="Hand"
                      AutomationProperties.Name="Unwrap Delegate Subgraph"
                      AutomationProperties.AutomationId="UnwrapDelegateSubgraphButton"
                      ToolTip.Tip="Decompile and visualize the internal NPU delegate execution graph">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                  <TextBlock Text="Unwrap Delegate Subgraph ➔" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Close / Deselect Action Button -->
            <Button Grid.Column="1"
                    Classes="toolbar-btn"
                    Command="{Binding DeselectNodeCommand}"
                    ToolTip.Tip="Deselect Node (Return to Overview)"
                    AutomationProperties.Name="Deselect Node"
                    AutomationProperties.AutomationId="DeselectNodeButton"
                    VerticalAlignment="Top"
                    Padding="6,4">
              <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
            </Button>
          </Grid>
        </Border>

        <!-- Typed Attributes Section -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,10">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Attributes"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              <Border Background="{DynamicResource ShellCanvasBackgroundBrush}"
                      CornerRadius="{DynamicResource RadiusPill}"
                      Padding="5,1">
                <TextBlock Text="{Binding SelectedNodeAttributes.Count}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontSize="10"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
              </Border>
            </StackPanel>

            <TextBlock Text="No explicit attributes declared for this node."
                       FontSize="11"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}"
                       IsVisible="{Binding !SelectedNodeAttributes.Count}" />

            <ItemsControl ItemsSource="{Binding SelectedNodeAttributes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NodeAttributeItem">
                  <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                          BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSmall}"
                          Padding="10,6"
                          Margin="0,2">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="11"
                                 Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                 VerticalAlignment="Center" />

                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="6"
                                  Margin="8,0">
                        <TextBlock Text="{Binding ValueText}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Classes="sample-btn"
                                Padding="6,2"
                                IsVisible="{Binding HasSubgraph}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DrillDownSubgraphCommand}"
                                CommandParameter="{Binding Subgraph}"
                                AutomationProperties.Name="Drill Down Subgraph"
                                ToolTip.Tip="Drill down into child subgraph">
                          <TextBlock Text="Drill Down ➔" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                        </Button>
                      </StackPanel>

                      <Border Grid.Column="2"
                              Background="{DynamicResource ShellSurfaceElevatedBrush}"
                              CornerRadius="{DynamicResource RadiusPill}"
                              Padding="6,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeName}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="9"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Input Connections & Weights Section -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,10">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Inputs &amp; Weights"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              <Border Background="{DynamicResource ShellCanvasBackgroundBrush}"
                      CornerRadius="{DynamicResource RadiusPill}"
                      Padding="5,1">
                <TextBlock Text="{Binding SelectedNodeInputs.Count}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontSize="10"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
              </Border>
            </StackPanel>

            <TextBlock Text="No inputs."
                       FontSize="11"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}"
                       IsVisible="{Binding !SelectedNodeInputs.Count}" />

            <ItemsControl ItemsSource="{Binding SelectedNodeInputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NodePortItem">
                  <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                          BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSmall}"
                          Padding="10,6"
                          Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding PortName}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontWeight="Bold"
                                     FontSize="11"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                          <TextBlock Text="{Binding KindBadge}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding TensorName}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding DataTypeText}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                          <TextBlock Text="{Binding ShapeText}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Details}"
                                   FontSize="9"
                                   Foreground="{DynamicResource ShellSuccessBrush}"
                                   IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                        <Button Classes="sample-btn"
                                Padding="6,2"
                                IsVisible="{Binding CanInspectWeights}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InspectTensorCommand}"
                                CommandParameter="{Binding Tensor}"
                                AutomationProperties.Name="Inspect Tensor Weights"
                                ToolTip.Tip="Inspect raw weights, statistics, and values">
                          <TextBlock Text="Weights 🔍" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                        </Button>

                        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusPill}"
                                Padding="6,2">
                          <TextBlock Text="{Binding QuantizationBadge}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="9"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Output Connections Section -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,10">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Outputs"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
              <Border Background="{DynamicResource ShellCanvasBackgroundBrush}"
                      CornerRadius="{DynamicResource RadiusPill}"
                      Padding="5,1">
                <TextBlock Text="{Binding SelectedNodeOutputs.Count}"
                           FontFamily="{DynamicResource CodeFontFamily}"
                           FontSize="10"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
              </Border>
            </StackPanel>

            <TextBlock Text="No outputs."
                       FontSize="11"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}"
                       IsVisible="{Binding !SelectedNodeOutputs.Count}" />

            <ItemsControl ItemsSource="{Binding SelectedNodeOutputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NodePortItem">
                  <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                          BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSmall}"
                          Padding="10,6"
                          Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding PortName}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontWeight="Bold"
                                     FontSize="11"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                          <TextBlock Text="{Binding KindBadge}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding TensorName}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding DataTypeText}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                          <TextBlock Text="{Binding ShapeText}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Details}"
                                   FontSize="9"
                                   Foreground="{DynamicResource ShellSuccessBrush}"
                                   IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                      <Border Grid.Column="1"
                              Background="{DynamicResource ShellSurfaceElevatedBrush}"
                              BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                              BorderThickness="1"
                              CornerRadius="{DynamicResource RadiusPill}"
                              Padding="6,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding QuantizationBadge}"
                                   FontFamily="{DynamicResource CodeFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- NPU Command Disassembly Section (When selected node has NPU commands) -->
        <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,10"
                IsVisible="{Binding HasNpuDisassembly}"
                AutomationProperties.Name="NPU Command Disassembly Panel"
                AutomationProperties.AutomationId="NpuCommandDisassemblyPanel">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="NPU Command Disassembly"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                <Border Background="{DynamicResource ShellAccentSubtleBrush}"
                        BorderBrush="{DynamicResource ShellAccentPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusPill}"
                        Padding="6,1">
                  <TextBlock Text="ETHOS-U"
                             FontFamily="{DynamicResource CodeFontFamily}"
                             FontSize="9"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
                </Border>
              </StackPanel>
            </Grid>

            <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                    BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    MaxHeight="260">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Padding="8,6">
                <SelectableTextBlock Text="{Binding NpuDisassemblyText}"
                                     FontFamily="{DynamicResource CodeFontFamily}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                     LineHeight="16" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
