<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DotNodeViewer.App.ViewModels"
             xmlns:controls="using:DotNodeViewer.App.Controls"
             xmlns:views="using:DotNodeViewer.App.Views"
             xmlns:ir="using:DotNodeViewer.Core.Ir"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="DotNodeViewer.App.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource ShellCanvasBackgroundBrush}"
             FontFamily="{DynamicResource UiFontFamily}"
             DragDrop.AllowDrop="True">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding #Canvas.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding #Canvas.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding #Canvas.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding #Canvas.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding #Canvas.ZoomToFitCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding #Canvas.ZoomToFitCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Base button styling -->
    <Style Selector="Button.toolbar-btn">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellCardHoverBrush}" />
    </Style>

    <Style Selector="Button.primary-btn">
      <Setter Property="Background" Value="{DynamicResource ShellAccentPrimaryBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary-btn:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.sample-btn">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sample-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top Toolbar / Header Strip -->
    <Border Grid.Row="0"
            Background="{DynamicResource ShellSurfaceBaseBrush}"
            BorderBrush="{DynamicResource ShellBorderMutedBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Logo / Brand Mark -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
          <Border Background="{DynamicResource ShellAccentPrimaryBrush}"
                  CornerRadius="6"
                  Width="24" Height="24">
            <TextBlock Text="D"
                       Foreground="#FFFFFF"
                       FontWeight="Bold"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="dot-node-viewer"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Foreground="{DynamicResource ShellTextPrimaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Open File Action -->
        <Button Grid.Column="1"
                Classes="toolbar-btn"
                Command="{Binding OpenModelCommand}"
                AutomationProperties.Name="Open Model"
                AutomationProperties.AutomationId="OpenModelButton"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Open Model..." VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Subgraph Selector (when model loaded) -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasModel}">
          <TextBlock Text="Subgraph:"
                     Foreground="{DynamicResource ShellTextSecondaryBrush}"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <ComboBox AutomationProperties.Name="Subgraph Selector"
                    AutomationProperties.AutomationId="SubgraphSelector"
                    ItemsSource="{Binding Subgraphs}"
                    SelectedItem="{Binding SelectedSubgraph}"
                    DisplayMemberBinding="{Binding Name}"
                    MinWidth="140"
                    FontSize="12"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    VerticalAlignment="Center" />
        </StackPanel>

        <!-- Theme Toggle -->
        <Button Grid.Column="3"
                Classes="toolbar-btn"
                Command="{Binding ToggleThemeCommand}"
                AutomationProperties.Name="Theme Toggle"
                AutomationProperties.AutomationId="ThemeToggleButton"
                Margin="8,0"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ThemeDisplayName}"
                     FontSize="12" />
        </Button>

      </Grid>
    </Border>

    <!-- Main Viewport Area -->
    <Grid Grid.Row="1">

      <!-- 1. EMPTY STATE -->
      <Border IsVisible="{Binding !HasModel}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="640"
              Margin="24"
              Padding="32"
              Background="{DynamicResource ShellSurfaceBaseBrush}"
              BorderBrush="{DynamicResource ShellBorderMutedBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusLarge}">
        <StackPanel Spacing="20" HorizontalAlignment="Center">

          <!-- Dropzone Icon Target -->
          <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="2"
                  CornerRadius="16"
                  Width="68" Height="68"
                  HorizontalAlignment="Center">
            <TextBlock Text="+"
                       FontSize="36"
                       FontWeight="Light"
                       Foreground="{DynamicResource ShellAccentPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="Open a Neural Network"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Drop an ONNX or TensorFlow Lite model file here to inspect its architecture."
                       FontSize="13"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Primary Open Action -->
          <Button Classes="primary-btn"
                  HorizontalAlignment="Center"
                  Command="{Binding OpenModelCommand}"
                  AutomationProperties.Name="Open Model Button"
                  AutomationProperties.AutomationId="EmptyStateOpenButton">
            <TextBlock Text="Browse Model File..." />
          </Button>

          <!-- Recent / Quick Sample Fixtures -->
          <Border BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="0,16,0,0"
                  Margin="0,8,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Quick Samples &amp; Recent Models"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />

              <ItemsControl ItemsSource="{Binding RecentFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="sample-btn"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadModelCommand}"
                            CommandParameter="{Binding}"
                            Margin="0,2"
                            HorizontalAlignment="Stretch">
                      <TextBlock Text="{Binding}"
                                 FontFamily="{DynamicResource CodeFontFamily}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Supported Formats Badge Strip -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0">
            <TextBlock Text="Supported Formats:"
                       FontSize="11"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="10,3">
              <TextBlock Text="ONNX (.onnx)"
                         FontSize="11"
                         FontWeight="Medium"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            </Border>
            <Border Background="{DynamicResource ShellSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="10,3">
              <TextBlock Text="TensorFlow Lite (.tflite)"
                         FontSize="11"
                         FontWeight="Medium"
                         Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            </Border>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- 2. CENTRAL GRAPH VIEWPORT & PROPERTIES SIDEBAR -->
      <Grid IsVisible="{Binding HasModel}" ColumnDefinitions="*,Auto,360">

        <!-- Left: Interactive GraphCanvas Viewport -->
        <Grid Grid.Column="0">
          <controls:GraphCanvas x:Name="Canvas"
                                Background="Transparent"
                                Layout="{Binding CurrentLayout}"
                                SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                AutomationProperties.Name="Graph Canvas"
                                AutomationProperties.AutomationId="GraphCanvas" />

          <!-- Canvas Floating Controls Overlay (Bottom-Right) -->
          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="16"
                  Background="{DynamicResource ShellSurfaceBaseBrush}"
                  BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMedium}"
                  Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="toolbar-btn"
                      Command="{Binding #Canvas.ZoomInCommand}"
                      ToolTip.Tip="Zoom In"
                      AutomationProperties.Name="Zoom In"
                      AutomationProperties.AutomationId="ZoomInButton"
                      Padding="8,4">
                <TextBlock Text="+" FontSize="13" FontWeight="Bold" />
              </Button>
              <Button Classes="toolbar-btn"
                      Command="{Binding #Canvas.ZoomOutCommand}"
                      ToolTip.Tip="Zoom Out"
                      AutomationProperties.Name="Zoom Out"
                      AutomationProperties.AutomationId="ZoomOutButton"
                      Padding="8,4">
                <TextBlock Text="-" FontSize="13" FontWeight="Bold" />
              </Button>
              <Button Classes="toolbar-btn"
                      Command="{Binding #Canvas.ZoomToFitCommand}"
                      ToolTip.Tip="Zoom to Fit Entire Graph"
                      AutomationProperties.Name="Zoom to Fit"
                      AutomationProperties.AutomationId="ZoomToFitButton"
                      Padding="8,4">
                <TextBlock Text="Fit" FontSize="11" />
              </Button>
              <Button Classes="toolbar-btn"
                      Command="{Binding #Canvas.ResetViewCommand}"
                      ToolTip.Tip="Reset Zoom (100%)"
                      AutomationProperties.Name="Reset View"
                      AutomationProperties.AutomationId="ResetViewButton"
                      Padding="8,4">
                <TextBlock Text="1:1" FontSize="11" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Bottom-Left Overlay: Interactive Minimap & Zoom HUD Indicator -->
          <StackPanel HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="16"
                      Spacing="8">
            <controls:MinimapControl x:Name="Minimap"
                                     Layout="{Binding CurrentLayout}"
                                     Zoom="{Binding #Canvas.Zoom}"
                                     PanOffset="{Binding #Canvas.PanOffset, Mode=TwoWay}"
                                     ViewportSize="{Binding #Canvas.ViewportSize}"
                                     AutomationProperties.Name="Minimap"
                                     AutomationProperties.AutomationId="GraphMinimap" />

            <Border Background="{DynamicResource ShellSurfaceBaseBrush}"
                    BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="8,4"
                    HorizontalAlignment="Left">
              <TextBlock Text="{Binding #Canvas.ZoomPercentText}"
                         FontFamily="{DynamicResource CodeFontFamily}"
                         FontSize="11"
                         Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </Border>
          </StackPanel>
        </Grid>

        <!-- Vertical Divider Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{DynamicResource ShellBorderMutedBrush}"
                      ResizeDirection="Columns" />

        <!-- Right: Basic Properties Sidebar (v1) -->
        <views:PropertiesPanelView Grid.Column="2"
                                   DataContext="{Binding}"
                                   AutomationProperties.Name="Properties Panel"
                                   AutomationProperties.AutomationId="PropertiesPanel" />
      </Grid>

      <!-- 3. ERROR BANNER / OVERLAY -->
      <Border IsVisible="{Binding HasError}"
              AutomationProperties.Name="Error Banner"
              AutomationProperties.AutomationId="ErrorBanner"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MaxWidth="560"
              Padding="24"
              Background="{DynamicResource ShellDangerSubtleBrush}"
              BorderBrush="{DynamicResource ShellDangerBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusLarge}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="/!\"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ShellDangerBrush}" />
            <TextBlock Text="Could Not Parse Model File"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellDangerBrush}" />
          </StackPanel>

          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="13"
                     Foreground="{DynamicResource ShellTextPrimaryBrush}"
                     TextWrapping="Wrap" />

          <StackPanel Spacing="4" IsVisible="{Binding ErrorOffsetHex, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="File Offset:"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorOffsetHex}"
                       FontFamily="{DynamicResource CodeFontFamily}"
                       FontSize="12"
                       Foreground="{DynamicResource ShellDangerBrush}" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding ErrorContext, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Context:"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorContext}"
                       FontSize="12"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Button Classes="toolbar-btn"
                  HorizontalAlignment="Right"
                  Command="{Binding ClearErrorCommand}"
                  Margin="0,8,0,0">
            <TextBlock Text="Dismiss" />
          </Button>
        </StackPanel>
      </Border>

      <!-- 4. LOADING OVERLAY -->
      <Border IsVisible="{Binding IsLoading}"
              Background="#80000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ShellSurfaceBaseBrush}"
                BorderBrush="{DynamicResource ShellBorderMutedBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="28"
                MinWidth="280">
          <StackPanel Spacing="16" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Foreground="{DynamicResource ShellAccentPrimaryBrush}" />
            <TextBlock Text="{Binding LoadingStatus}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>

    </Grid>

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource ShellSurfaceBaseBrush}"
            BorderBrush="{DynamicResource ShellBorderMutedBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding ModelPath}"
                   FontSize="11"
                   FontFamily="{DynamicResource CodeFontFamily}"
                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="16,0" />

        <TextBlock Grid.Column="2"
                   Text="{Binding LayoutDurationMs, StringFormat='Layout: {0:F1}ms'}"
                   FontSize="11"
                   FontFamily="{DynamicResource CodeFontFamily}"
                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasModel}" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
